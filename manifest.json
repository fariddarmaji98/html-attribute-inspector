{
  "manifest_version": 3,
  "name": "HTML Attribute Inspector",
  "version": "1.0.1",
  "description": "Hover any element to see all its HTML attributes in a popup. Ctrl+right-click to lock. Copy values with one click.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HTML Attribute Inspector",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
