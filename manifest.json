{
  "manifest_version": 3,
  "name": "Attribute Inspector",
  "version": "1.0.0",
  "description": "Hover any element to see all its HTML attributes in a popup. Click to lock selection.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Attribute Inspector",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
